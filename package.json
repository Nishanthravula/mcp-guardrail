{
  "name": "mcp-guardrail",
  "version": "0.1.0",
  "description": "Zero-dependency sanitizing proxy for MCP servers — redacts secrets and PII from Model Context Protocol payloads before they reach the LLM.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "secrets",
    "redaction",
    "pii",
    "llm",
    "sanitizer",
    "proxy"
  ],
  "license": "MIT",
  "author": "Nishanth Ravula",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-guardrail": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && tsx --test tests/e2e/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishanthravula/mcp-guardrail.git"
  },
  "homepage": "https://github.com/Nishanthravula/mcp-guardrail#readme",
  "bugs": {
    "url": "https://github.com/Nishanthravula/mcp-guardrail/issues"
  }
}
